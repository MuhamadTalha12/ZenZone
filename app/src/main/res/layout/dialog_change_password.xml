<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/zen_slate_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change Password"
        android:textColor="@color/zen_slate_surface"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_font_family"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your new password below. It must be at least 6 characters."
        android:textColor="@color/zen_gray_text"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_font_family"
        android:layout_marginBottom="24dp" />

    <!-- Password Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_settings_password"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="New Password"
        app:hintTextColor="@color/zen_teal_light"
        app:boxStrokeColor="@color/zen_teal_light"
        app:boxStrokeWidthFocused="2dp"
        app:boxStrokeWidth="1dp"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/zen_teal_light"
        app:boxBackgroundColor="#1AFFFFFF">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_settings_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textColorHint="#80FFFFFF"
            android:inputType="textPassword"
            android:fontFamily="@font/poppins_font_family"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm Password Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_settings_confirm_password"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Confirm New Password"
        app:hintTextColor="@color/zen_teal_light"
        app:boxStrokeColor="@color/zen_teal_light"
        app:boxStrokeWidthFocused="2dp"
        app:boxStrokeWidth="1dp"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/zen_teal_light"
        app:boxBackgroundColor="#1AFFFFFF">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_settings_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textColorHint="#80FFFFFF"
            android:inputType="textPassword"
            android:fontFamily="@font/poppins_font_family"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Update Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings_update_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UPDATE PASSWORD"
        android:textColor="@color/zen_slate_surface"
        android:backgroundTint="@color/zen_teal_primary"
        android:fontFamily="@font/poppins_font_family"
        android:textStyle="bold"
        android:paddingVertical="14dp"
        app:cornerRadius="12dp" />

</LinearLayout>
