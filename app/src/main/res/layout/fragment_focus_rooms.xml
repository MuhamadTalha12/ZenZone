<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_slate_bg">

    <!-- Common Navbar -->
    <include
        android:id="@+id/navbar_include"
        layout="@layout/layout_common_navbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Back Button & Header -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toBottomOf="@id/navbar_include">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/zen_slate_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Co-Focus Rooms"
            android:fontFamily="@font/poppins_font_family"
            android:textColor="@color/zen_slate_dark"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="40dp">

            <!-- Create / Join Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_room_setup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/zen_slate_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Join or Create Focus Room"
                        android:fontFamily="@font/poppins_font_family"
                        android:textColor="@color/zen_slate_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Focus with friends in a shared room without distraction."
                        android:fontFamily="@font/poppins_font_family"
                        android:textColor="@color/zen_gray_text"
                        android:textSize="12sp" />

                    <!-- Input Room Code -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_room_code"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Enter 6-Digit Room Code"
                        app:hintTextColor="@color/zen_teal_primary"
                        app:boxStrokeColor="@color/zen_teal_primary"
                        app:boxStrokeWidthFocused="2dp"
                        app:boxStrokeWidth="1dp"
                        app:boxBackgroundColor="#1A000000">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_room_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:maxLength="6"
                            android:textColor="@color/zen_slate_dark"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_font_family" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_join_room"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="@color/zen_teal_primary"
                            android:text="Join Room"
                            android:textColor="@color/zen_slate_surface"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_create_room"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:text="Create Room"
                            android:textColor="@color/zen_teal_primary"
                            app:strokeColor="@color/zen_teal_primary"
                            app:strokeWidth="1.5dp"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Room Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_active_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/zen_slate_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_room_id"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Room: ROOMID"
                                android:fontFamily="@font/poppins_font_family"
                                android:textColor="@color/zen_slate_dark"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_room_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Waiting for host to start..."
                                android:fontFamily="@font/poppins_font_family"
                                android:textColor="@color/zen_gray_text"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_leave_room"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Leave"
                            android:textColor="@color/zen_danger_red" />
                    </LinearLayout>

                    <!-- Large Timer Countdown -->
                    <TextView
                        android:id="@+id/tv_room_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="20dp"
                        android:text="25:00"
                        android:textColor="@color/zen_teal_primary"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_font_family" />

                    <!-- Host Controls -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_host_action"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/zen_teal_primary"
                        android:text="Start Timer"
                        android:textColor="@color/zen_slate_surface"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Participants"
                        android:fontFamily="@font/poppins_font_family"
                        android:textColor="@color/zen_slate_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Participant List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_participants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
