<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="176dp"
    android:background="@color/zen_slate_dark"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <ImageView
        android:id="@+id/iv_drawer_logo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_lotus_logo"
        app:tint="@color/white"
        android:contentDescription="App Logo" />

    <TextView
        android:id="@+id/tv_drawer_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins_font_family"
        android:text="Zen Mind"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_drawer_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_font_family"
        android:text="Level 1 Practitioner"
        android:textColor="@color/zen_teal_light"
        android:textSize="14sp" />

</LinearLayout>
