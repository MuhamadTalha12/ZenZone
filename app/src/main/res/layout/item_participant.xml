<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tv_participant_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/ic_profile"
        android:gravity="center"
        android:text="Z"
        android:textColor="@color/zen_slate_dark"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_participant_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:fontFamily="@font/poppins_font_family"
            android:textColor="@color/zen_slate_dark"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_participant_status_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:fontFamily="@font/poppins_font_family"
            android:textColor="@color/zen_gray_text"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_participant_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/zen_teal_light"
        android:textColor="@color/zen_teal_dark"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="Ready"
        android:fontFamily="@font/poppins_font_family" />
</LinearLayout>
